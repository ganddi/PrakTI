{
  "version": 2,
  "builds": [
    { "src": "/api/index.php", "use": "vercel-php@0.7.3" },
    { "src": "/public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/(css|js|build|favicon.ico|robots.txt)(.*)", "dest": "public/$1$2" },
    { "src": "/(.*)", "dest": "/api/index.php" }
  ]
}